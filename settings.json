{
  // ------------------------
  // Editor
  // ------------------------
  "editor.fontSize": 18,
  "editor.fontFamily": "Playwrite AU SA, Operator Mono",
  "editor.fontStyle": "italic",
  "editor.fontLigatures": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic",
        },
      },
    ],
  },

  // Cursor
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",

  // ------------------------
  // Formatting (FIXED)
  // ------------------------
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  "[vue]": {
    "editor.defaultFormatter": "Vue.volar",
    "editor.formatOnSave": false,
  },

  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },

  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true,
  },

  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": true,
  },

  // ❌ REMOVE conflicting formatter
  // "lonefy.vscode-JS-CSS-HTML-formatter"

  // ------------------------
  // ESLint
  // ------------------------
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
  },

  "eslint.alwaysShowStatus": true,

  // ------------------------
  // Terminal
  // ------------------------
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontFamily": "poppins",

  "workbench.colorCustomizations": {
    "terminal.background": "#1A2130",
    "terminal.foreground": "#d3d3d3",
  },

  // ------------------------
  // Misc
  // ------------------------
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,

  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Learn with Sumit Theme",

  // Vue
  "vue.format.defaultFormatter.html": "prettier",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\WAHID\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true
  },
  "files.autoSave": "onFocusChange",
  "chat.disableAIFeatures": true,
  "vscode-pets.petColor": "lightbrown",
  "vscode-pets.petType": "panda",
  "vscode-pets.theme": "forest",
}
